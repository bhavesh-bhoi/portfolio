# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Email Configuration
# Choose ONE of the following options:

# Option 1: Gmail
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM_ADDRESS=noreply@example.com
# EMAIL_RECIPIENT=your-email@gmail.com

# Option 2: Custom SMTP Server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# EMAIL_FROM_ADDRESS=noreply@example.com
# EMAIL_RECIPIENT=recipient@example.com

# Option 3: File Storage (Development Only)
# Messages will be saved to /messages directory
# No email configuration needed

# Google Sheets (optional)
# Deploy google-apps-script/Code.gs as a Web App, then configure:
# GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/your-deployment-id/exec
# GOOGLE_SHEETS_SHARED_SECRET=use-the-same-long-random-secret-in-apps-script-properties
